# Copy to .env and fill in. Every value is read inside a request handler,
# never at build time. See docs/DEPLOYMENT.md for where to get each one.

# --- LLM (Gemini) ---
# Intent extraction, grounded explanations, JD parsing, verification interview,
# and embeddings. Optional: explanations fall back to deterministic text without
# it, but the JD gap analyzer and the verification interview are unavailable.
GEMINI_API_KEY=

# --- Data stores ---
MONGODB_URI=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
QDRANT_URL=
QDRANT_API_KEY=

# --- Evidence signing ---
# HMAC key for the signature on every evidence record, checked by /verify/<id>.
# Optional: a well-known dev key is used when unset (signatures still verify
# within one deployment, they are just not unforgeable). Set a real random value
# anywhere a shared evidence link needs to mean something.
EVIDENCE_SIGNING_SECRET=

# --- Admin ---
# Comma-separated emails allowed into /admin. Unset means nobody is an admin.
ADMIN_EMAILS=
